# ============================================================================
# BlkMaC 环境配置模板
# ----------------------------------------------------------------------------
# 用法：复制本文件为 .env 后按需修改。.env 已被 .gitignore 忽略，
#       切勿把真实私钥 / API Key 提交到版本库。
#
#   PowerShell:  Copy-Item .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# [1] LLM 大模型接口
# ---------------------------------------------------------------------------
# LLM_PROVIDER 决定使用哪个后端实现（llm/llm_api.py::get_llm）
#   mock      —— 内置确定性模拟模型，零依赖零成本，对照实验默认使用
#   openai    —— 任何 OpenAI 兼容的 /v1/chat/completions 端点
#                （OpenAI / DeepSeek / Moonshot / vLLM / Ollama / LM Studio）
#   anthropic —— Anthropic /v1/messages 端点
LLM_PROVIDER=mock

# 主模型（复杂子任务）与小模型（简单子任务）——阶段4「混合大模型协同」的切换点
# 阶段3.1 真实实验可将 LLM_MODEL 改为 gpt-4o-mini、deepseek-chat、qwen-plus
# 或部署的 Llama 模型名；OpenAI/DeepSeek/Qwen/Llama 兼容接口统一使用 openai provider。
LLM_MODEL=mock-large
LLM_MODEL_SMALL=mock-small

# 真实后端凭据。LLM_PROVIDER=mock 时全部忽略。
#   openai    示例：LLM_BASE_URL=https://api.deepseek.com   LLM_API_KEY=sk-xxx
#   anthropic 示例：LLM_BASE_URL=https://api.anthropic.com  LLM_API_KEY=sk-ant-xxx
LLM_BASE_URL=
LLM_API_KEY=

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# MockLLM 专用：模拟幻觉发生率（0.0~1.0）与模拟网络延迟区间（毫秒）
# 对照实验靠这三个参数产生可复现的差异，改动会直接影响实验图表
MOCK_HALLUCINATION_RATE=0.18
MOCK_LATENCY_MIN_MS=40
MOCK_LATENCY_MAX_MS=180
MOCK_SEED=20250728

# ---------------------------------------------------------------------------
# [2] 区块链（Ganache / 以太坊私链）
# ---------------------------------------------------------------------------
# CHAIN_ENABLED=false 时全流程跳过上链，其余模块完全不受影响。
# 本机若未安装 Node.js 则无法启动 Ganache，请保持 false。
CHAIN_ENABLED=false
CHAIN_RPC_URL=http://127.0.0.1:8545

# Ganache 启动后复制第一个账户的私钥（0x 开头，64 位十六进制）
CHAIN_PRIVATE_KEY=

# 运行 python deploy_contract.py 部署成功后，把输出的合约地址填到这里
CONTRACT_ADDRESS=

# 交易参数。私链上 gas 不要钱，给足即可。
CHAIN_ID=1337
CHAIN_GAS_LIMIT=1000000
CHAIN_TX_TIMEOUT=120

# 阶段4 预留：轻量联盟链后端（eth | fisco）
LEDGER_BACKEND=eth

# ---------------------------------------------------------------------------
# [3] 加密 TCP 通信
# ---------------------------------------------------------------------------
TCP_HOST=127.0.0.1
# 各 Task Agent 依次占用 TCP_BASE_PORT, +1, +2 ... 端口
TCP_BASE_PORT=9101
TCP_TIMEOUT=30
# 单帧最大字节数，防止恶意超长帧撑爆内存
TCP_MAX_FRAME=4194304

# ---------------------------------------------------------------------------
# [4] 密码学
# ---------------------------------------------------------------------------
# 2048 位足够且快；调到 4096 会让每个 Agent 的密钥生成明显变慢
RSA_KEY_BITS=2048
# Controller 长期密钥的存放目录（相对项目根目录）
RSA_KEY_DIR=crypto

# ---------------------------------------------------------------------------
# [5] 对照实验
# ---------------------------------------------------------------------------
DATASET_PATH=test_dataset/questions.json
RESULTS_DIR=results
# 参与实验的 Task Agent 数量
AGENT_COUNT=4
# 全局随机种子，保证三组实验可复现
EXPERIMENT_SEED=20250728

# 能力打分函数权重： score = w_cap*能力 + w_load*空闲度 + w_succ*历史成功率 - w_diff*难度惩罚
# w_diff 默认 0.0 —— 阶段4「优化评估函数（增加任务难度权重）」的开关
SCORE_W_CAPABILITY=0.5
SCORE_W_LOAD=0.3
SCORE_W_SUCCESS=0.2
SCORE_W_DIFFICULTY=0.0
# 自适应调度额外权重（--scheduling adaptive 生效）
# score = 能力 + 成功率 + 难度匹配度 - 负载 - 错误率 - 响应时间
SCORE_W_DIFFICULTY_MATCH=0.2
SCORE_W_ERROR=0.1
SCORE_W_LATENCY=0.05
SCORE_W_TRUST=0.15
# Trust-aware 信誉维护：每次子任务完成后更新，范围最终限制在 0~1
TRUST_INITIAL_SCORE=0.5
TRUST_SUCCESS_REWARD=0.05
TRUST_HALLUCINATION_PENALTY=0.15
TRUST_FAILURE_PENALTY=0.1

# ---------------------------------------------------------------------------
# [6] 日志
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
